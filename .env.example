# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional: set to skip the interactive phone prompt on first login.
# TG_PHONE=+7XXXXXXXXXX
# TG_PASSWORD=your-2fa-password-if-enabled

# Session cache file name (created on first successful login, reused after).
TG_SESSION_NAME=tgp_session

# VPN/SOCKS5 proxy (e.g. Happ client running locally), needed if Telegram
# is blocked from where you run this.
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Tuning
ACTIVE_WINDOW_HOURS=24
MESSAGES_PER_CHAT=150
MAX_PAGES_PER_QUERY=10
REQUEST_DELAY_SECONDS=1.5
OUTPUT_DIR=out

# How many confirmed sources to aim for before stopping (search + snowball
# keep running until both targets are hit, the candidate pool runs out, or
# MAX_RUNTIME_MINUTES is reached). Realistically you may still end up with
# fewer if the candidate pool runs dry first -- rerun the tool later (results
# accumulate across runs, see README) or add more to seeds.txt to push higher.
TARGET_CHANNELS=150
TARGET_CHATS=30

# How many chats to analyze in parallel.
CONCURRENCY=5

# How many "follow the links mentioned in already-found sources" rounds to
# run after the main search, to push past what search alone finds.
SNOWBALL_MAX_ROUNDS=6

# Safety cap on total run time (set empty to disable).
MAX_RUNTIME_MINUTES=180

# Optional file with extra candidate channels/chats you already know about
# (one @username or t.me link per line, '#' for comments) — e.g. copied out
# of a TGStat/Telega.in catalog page. Skipped if the file doesn't exist.
SEEDS_FILE=seeds.txt

# Send every confirmed source to your Telegram "Saved Messages" (Избранное)
# the moment it's found, instead of waiting for the run to finish.
NOTIFY_SAVED_MESSAGES=true
