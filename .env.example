# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional: set to skip the interactive phone prompt on first login.
# TG_PHONE=+7XXXXXXXXXX
# TG_PASSWORD=your-2fa-password-if-enabled

# Session cache file name (created on first successful login, reused after).
TG_SESSION_NAME=tgp_session

# VPN/SOCKS5 proxy (e.g. Happ client running locally), needed if Telegram
# is blocked from where you run this.
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Tuning
ACTIVE_WINDOW_HOURS=24
MESSAGES_PER_CHAT=150
MAX_PAGES_PER_QUERY=10
REQUEST_DELAY_SECONDS=1.5
OUTPUT_DIR=out

# How many confirmed sources to aim for before stopping (search + snowball
# keep running until both targets are hit, the candidate pool runs out, or
# MAX_RUNTIME_MINUTES is reached). Realistically you may still end up with
# fewer if the candidate pool runs dry first -- rerun the tool later (results
# accumulate across runs, see README) or add more to seeds.txt to push higher.
TARGET_CHANNELS=150
TARGET_CHATS=30

# How many chats to analyze in parallel.
CONCURRENCY=5

# How many "follow the links mentioned in already-found sources" rounds to
# run after the main search, to push past what search alone finds. Each
# round scans EVERY message fetched from EVERY confirmed source (not just
# the sample posts shown in the report) for t.me/... links -- this is the
# main thing that turns a few-minute run into a multi-hour one, since each
# round can surface a new batch of chats/channels to check in turn.
SNOWBALL_MAX_ROUNDS=25

# Safety cap on total run time (set empty to disable). This is a ceiling,
# not a target -- the run stops earlier on its own once targets are hit or
# there are no more links left to follow. 360 = 6 hours; raise it (e.g. 600
# for 10h) if you want it to keep digging longer before giving up.
MAX_RUNTIME_MINUTES=360

# Optional file with extra candidate channels/chats you already know about
# (one @username or t.me link per line, '#' for comments) — e.g. copied out
# of a TGStat/Telega.in catalog page. Skipped if the file doesn't exist.
SEEDS_FILE=seeds.txt

# Send every confirmed source to your Telegram "Saved Messages" (Избранное)
# the moment it's found, instead of waiting for the run to finish.
NOTIFY_SAVED_MESSAGES=true

# Some public chats hide their message history from non-members. If true,
# the tool joins them automatically to read it (chats that require admin
# approval to join are never auto-joined -- see "Требуют заявки на
# вступление" in the report instead). This adds chats to your account's
# joined-chats list and is the main account-safety-sensitive setting here;
# see the "Ограничения" section of the README before raising the two
# settings below.
AUTO_JOIN_CHATS=true

# Extra pause specifically around join actions (separate from
# REQUEST_DELAY_SECONDS) -- joins are more likely to trigger Telegram's
# anti-spam limits than reads, so this is intentionally more conservative.
JOIN_DELAY_SECONDS=8

# Hard cap on how many chats to auto-join in a single run, regardless of
# how many would need it -- keeps a single run from mass-joining hundreds
# of groups on your account.
MAX_JOINS_PER_RUN=150
